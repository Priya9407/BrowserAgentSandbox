{
  "manifest_version": 3,
  "name": "Aegis Vigilis",
  "version": "0.1.0",
  "description": "Run Aegis Vigilis on any tab via a side panel chat.",

  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8000/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Open Aegis Vigilis",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
